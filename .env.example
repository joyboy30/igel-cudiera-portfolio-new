# Contact form (api/contact.ts). Set these in Vercel > Project > Settings >
# Environment Variables. Never commit real values, and never give them a
# VITE_ prefix: that would ship them to the browser.

# Required. API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender on a domain you verified in Resend, e.g.
# Portfolio <contact@yourdomain.com>. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to the email address the Resend
# account was created with - so create it with igel.cudiera31@gmail.com.
CONTACT_FROM_EMAIL=
